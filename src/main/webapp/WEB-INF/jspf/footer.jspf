</main>

<footer class="site-footer">
    <div class="footer-features">
        <div class="feature-item">
            <span class="feature-icon">🚀</span>
            <div>
                <h4>Fast Free Delivery</h4>
                <p>On orders above $500</p>
            </div>
        </div>
        <div class="feature-item">
            <span class="feature-icon">🛡️</span>
            <div>
                <h4>Buyer Protection</h4>
                <p>100% Genuine guaranteed</p>
            </div>
        </div>
        <div class="feature-item">
            <span class="feature-icon">🔄</span>
            <div>
                <h4>7-Day Returns</h4>
                <p>Hassle-free replacement</p>
            </div>
        </div>
        <div class="feature-item">
            <span class="feature-icon">🔒</span>
            <div>
                <h4>Secure Payments</h4>
                <p>Encrypted checkout</p>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="footer-info">
            <p class="footer-brand">KeerthanyaMart &bull; Anna University R2025 Semester 3 Capstone Project</p>
            <p class="footer-copy">&copy; 2026 KeerthanyaMart. All rights reserved.</p>
        </div>
    </div>
</footer>

<div id="chatWidget" class="chat-widget">
    <button id="chatToggle" class="chat-toggle" aria-label="Open support chat">&#128172;</button>
    <div id="chatPanel" class="chat-panel hidden">
        <div class="chat-panel-header">
            <span>KeerthanyaMart Assistant</span>
            <button id="chatClose" aria-label="Close chat">&times;</button>
        </div>
        <div id="chatMessages" class="chat-messages"></div>
        <form id="chatForm" class="chat-form">
            <input id="chatInput" type="text" maxlength="500" placeholder="Ask about orders, shipping, returns..." autocomplete="off" />
            <button type="submit">Send</button>
        </form>
    </div>
</div>

<script src="${pageContext.request.contextPath}/js/auth.js"></script>
<script src="${pageContext.request.contextPath}/js/chat-widget.js"></script>
</body>
</html>
