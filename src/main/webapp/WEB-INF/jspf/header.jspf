<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KeerthanyaMart &mdash; Online Shopping</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        window.APP_CONTEXT_PATH = "${pageContext.request.contextPath}";
    </script>
    <script src="${pageContext.request.contextPath}/js/api.js"></script>
</head>
<body>
<div class="top-announcement">
    <span>✨ Free Express Delivery on orders over $500 &bull; 100% Genuine Products</span>
</div>

<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="${pageContext.request.contextPath}/jsp/index.jsp">
            <span class="brand-badge">🛍️</span>
            <span class="brand-text">Keerthanya<span class="brand-accent">Mart</span></span>
        </a>

        <div class="header-search-container">
            <form id="headerSearchForm" action="${pageContext.request.contextPath}/jsp/index.jsp" method="get" class="header-search-form">
                <select name="category" id="headerCategorySelect" class="header-search-cat">
                    <option value="">All Categories</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Apparel">Apparel</option>
                    <option value="Home">Home</option>
                </select>
                <input type="text" name="q" id="headerSearchInput" placeholder="Search products, brands, essentials..." autocomplete="off">
                <button type="submit" class="header-search-btn" aria-label="Search">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </button>
            </form>
        </div>

        <nav class="header-nav">
            <a href="${pageContext.request.contextPath}/jsp/index.jsp" class="nav-item">
                <span class="nav-icon">🏪</span>
                <span>Shop</span>
            </a>
            <a href="${pageContext.request.contextPath}/jsp/orders.jsp" class="nav-item">
                <span class="nav-icon">📦</span>
                <span>Orders</span>
            </a>
            <a href="${pageContext.request.contextPath}/jsp/cart.jsp" class="nav-item nav-cart">
                <span class="nav-icon">🛒</span>
                <span>Cart</span>
                <span class="cart-badge" id="cartBadge" style="display:none;">0</span>
            </a>
            <c:if test="${sessionScope.authUser.role == 'SELLER' || sessionScope.authUser.role == 'ADMIN'}">
                <a href="${pageContext.request.contextPath}/jsp/seller-dashboard.jsp" class="nav-item nav-special">
                    <span class="nav-icon">📊</span>
                    <span>Dashboard</span>
                </a>
            </c:if>
            <c:if test="${sessionScope.authUser.role == 'ADMIN'}">
                <a href="${pageContext.request.contextPath}/jsp/admin.jsp" class="nav-item nav-special">
                    <span class="nav-icon">⚙️</span>
                    <span>Admin</span>
                </a>
            </c:if>
        </nav>

        <div class="session-box" id="sessionBox">
            <c:choose>
                <c:when test="${not empty sessionScope.authUser}">
                    <div class="user-pill">
                        <span class="user-avatar">👤</span>
                        <div class="user-meta">
                            <span class="user-name"><c:out value="${sessionScope.authUser.name}"/></span>
                            <span class="user-role"><c:out value="${sessionScope.authUser.role}"/></span>
                        </div>
                        <button id="logoutBtn" class="btn-logout" title="Log out">Sign out</button>
                    </div>
                </c:when>
                <c:otherwise>
                    <div class="auth-buttons">
                        <a href="${pageContext.request.contextPath}/jsp/login.jsp" class="btn-login">Sign In</a>
                        <a href="${pageContext.request.contextPath}/jsp/register.jsp" class="btn-register">Register</a>
                    </div>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>

<div id="toastContainer" class="toast-container"></div>
<main class="site-main">
